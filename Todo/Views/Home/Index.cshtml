    // foreach(var taskItem in uncompletedTasks)
    // {
    //     taskItem.taskPrint();
    // }
    //test


}


<div class="create sticky-top " style="background-color:white">
    <form asp-action="CreateTask">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="NewTask.Description" class="control-label fw-bold">New Task</label>
            <input asp-for="NewTask.Description" class="form-control" />
            <span asp-validation-for="NewTask.Description" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
</div>



<br />

<div class="d-flex   align-content-center gap-lg-5 gap-md-5 gap-sm-3">
    <div class="uncompleted-tasks card" style="display:inline; padding:1rem">
        <h2 class="card-title">To do </h2>
        <table class="card-body">

        @foreach(TaskItem task in uncompletedTasks)
        {
            <tr>
                <td>
                    @(++unCompletedCounter))
                </td>
                <td>
                    <a asp-action="Edit" asp-controller="Home" asp-route-id="@task.TaskId" class="plain-link">
                    @Html.DisplayFor(item => task.Description)
                    </a>

                </td>
                <td>
                    <form asp-action="UpdateStatus" asp-controller="Home" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@task.TaskId" />
                        <button type="submit" class="btn btn-success btn-sm">@(task.IsCompleted ? "Undo" : "Done")</button>
                    </form>
                </td>
            </tr>
            
        }
        </table>
    </div>

    <div class="completed-tasks card" style="display:inline ;padding:1rem">
            <h2 class="card-title">Completed Tasks </h2>
        <table class="card-body">
            @foreach (TaskItem task in completedTasks)
            {
                <tr>
                    <td>
                        @(++completedCounter))
                    </td>
                    <td>
                        <a asp-action="Edit" asp-controller="Home" asp-route-id="@task.TaskId" class="plain-link">
                            @Html.DisplayFor(item => task.Description)
                        </a>
                    </td>
                    <td>
                        <form asp-action="UpdateStatus" asp-controller="Home" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@task.TaskId" />
                            <button type="submit" class="btn btn-success btn-sm">@(task.IsCompleted ? "Undo" : "Done")</button>
                        </form>
                    </td>
                </tr>

            }
        </table>
    </div>

</div>
