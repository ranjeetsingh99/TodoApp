@model Todo.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home Page";
    int completedCounter = 0,unCompletedCounter = 0;

    TaskItem[] completedTasks = Model.Tasks!.Where(t => t.IsCompleted).ToArray();
    TaskItem[] uncompletedTasks = Model.Tasks!.Where(t => t.IsCompleted == false).ToArray();

    // foreach(TaskItem taskItem in Model.Tasks!)
