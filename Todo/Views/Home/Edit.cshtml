@model Todo.Models.TaskItem

@{
    ViewData["Title"] = "Edit";
    Model.taskPrint();
}

Task Id: @Model.TaskId Status: @Html.DisplayFor(i => Model.IsCompleted)
<br />
Created At: @Model.CreatedAt
<br/>
Updated At: @Model.UpdatedAt


<form asp-action="Edit" >
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="TaskId" />
    <div class="form-group">
        <label asp-for="Description" class="control-label"></label> 
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>

    </div>


    <div class="form-group">
        <input type="submit" value="Edit" class="btn btn-primary" />
    </div>
  
</form>
<br /> 

<form asp-action="DeleteTask" asp-controller="Home" method="post" style="display: inline" onsubmit="return confirm('Are you sure that you want delete this task')">
        <input type="hidden" name="taskId" value="@Model.TaskId" />
        <button type="submit" class="btn btn-danger ">Delete</button>
</form>
